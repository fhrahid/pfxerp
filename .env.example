# ==========================================
# APPLICATION & RUNTIME
# ==========================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CLIENT_URL=http://localhost:3000

# ==========================================
# DATABASE (POSTGRESQL)
# ==========================================
DB_PASSWORD=pointfex_dev_password
DATABASE_URL="postgresql://pointfex_admin:pointfex_dev_password@localhost:5432/pointfex_db?schema=public&connection_limit=25"

# ==========================================
# CRYPTOGRAPHY & AUTHENTICATION
# ==========================================
JWT_SECRET=replace_with_jwt_secret_minimum_64_bytes_change_me_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
LEDGER_SECRET_KEY=replace_with_ledger_hmac_secret_sha256_change_me
ALLOWED_EMAIL_DOMAIN=seu.edu.bd

# ==========================================
# CEO & SYSTEM SEEDING CREDENTIALS
# ==========================================
INITIAL_CEO_EMAIL=noor@seu.edu.bd
INITIAL_CEO_PASSWORD=PointfexCeo2026!
INITIAL_SYSTEM_RESERVE_FUND=5000000.00

# ==========================================
# EMAIL & RESEND SERVICE
# ==========================================
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
RESEND_FROM_EMAIL="Pointfex ERP <cpo@pointfex.com>"
INVITATION_EXPIRES_IN_HOURS=72
PASSWORD_RESET_EXPIRES_IN_MINUTES=60
